diff --color -ur a/src/forward.c b/src/forward.c
--- a/src/forward.c	2026-06-04 19:47:22.000000000 +0800
+++ b/src/forward.c	2026-09-12 07:32:21.707393661 +0800
@@ -1658,7 +1658,22 @@
   if (n < (int)sizeof(struct dns_header) || 
       (msg.msg_flags & MSG_TRUNC) ||
       (header->hb3 & HB3_QR))
-    return;
+    {
+      /* dnsmasq-fuzz-reply.patch: upstream silently drops malformed datagrams
+	 (hardening added after 2.85). AFLNet deadlocks waiting for a response
+	 that never comes, so reply REFUSED to anything dropped at this gate. */
+      unsigned char refuse[12] = {0};
+      if (n >= 2)
+	{
+	  refuse[0] = ((unsigned char *)header)[0];
+	  refuse[1] = ((unsigned char *)header)[1];
+	}
+      refuse[2] = 0x80; /* QR */
+      refuse[3] = 5;    /* REFUSED */
+      if (source_addr.sa.sa_family == AF_INET)
+	sendto(listen->fd, refuse, 12, 0, &source_addr.sa, sizeof(source_addr.in));
+      return;
+    }
 
   /* Clear buffer beyond request to avoid risk of
      information disclosure. */
